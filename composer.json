{
  "name": "s3rgiosan/elasticpress-content-connect",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "10up",
      "email": "info@10up.com"
    },
    {
      "name": "Sérgio Santos",
      "homepage": "https://s3rgiosan.dev"
    }
  ],
  "require": {
    "php": "^7.4|^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "config": {
    "platform": {
      "php": "8.2"
    }
  },
  "autoload": {
    "psr-4": {
      "EPContentConnect\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EPContentConnect\\Tests\\Unit\\": "tests/php/unit/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
